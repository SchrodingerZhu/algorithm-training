#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
stage="${1:-01}"
case "$stage" in
  smoke) target=environment_smoke; pattern='^Environment$' ;;
  [0-9][0-9]|[0-9][0-9]-[a-z])
    if [[ ! -f "exercises/$stage.cppm" ]]; then echo "当前分支没有第 $stage 题。" >&2; exit 2; fi
    target="stage_$stage"; pattern="^Stage$stage$" ;;
  all) target=all; pattern='^(Environment|Stage[0-9]+(-[a-z])?)$' ;;
  *) echo '用法：./judge [smoke|两位题号|扩展题号（如 10-a）|all]' >&2; exit 2 ;;

esac
if ! command -v cmake >/dev/null || ! command -v clang++ >/dev/null; then
  echo '请先在此目录运行 nix develop，再运行 ./judge。' >&2
  exit 2
fi
build_dir="${TRAINING_BUILD_DIR:-$PWD/build}"
compiler="$(command -v clang++)"
toolchain="$PWD/cmake/nix-toolchain.cmake"
configure_args=()
if [[ -f "$build_dir/CMakeCache.txt" ]]; then
  cached_compiler="$(sed -n 's/^CMAKE_CXX_COMPILER:[^=]*=//p' "$build_dir/CMakeCache.txt")"
  cached_toolchain="$(sed -n 's/^CMAKE_TOOLCHAIN_FILE:[^=]*=//p' "$build_dir/CMakeCache.txt")"
  # Reset before configuring: CMake's compiler-change reset drops toolchain settings.
  if [[ "$cached_compiler" != "$compiler" || "$cached_toolchain" != "$toolchain" ]]; then
    configure_args+=(--fresh)
  fi
fi
cmake "${configure_args[@]}" -S . -B "$build_dir" -G Ninja -DCMAKE_BUILD_TYPE=Debug \
  -DCMAKE_TOOLCHAIN_FILE="$toolchain" \
  -DCMAKE_CXX_COMPILER="$compiler" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
cmake --build "$build_dir" --target "$target" --parallel "${CMAKE_BUILD_PARALLEL_LEVEL:-2}"
ctest --test-dir "$build_dir" --output-on-failure --no-tests=error -R "$pattern"
